{
  "modules": [
    {
      "slug": "automation-judgment",
      "order": 1,
      "title": {
        "en": "Automation Foundations & Judgment",
        "id": "Fondasi Web Automation & QA Judgment"
      },
      "description": {
        "en": "Understand what web automation can prove, choose worthwhile candidates, and frame them as repeatable checks.",
        "id": "Kenali apa yang bisa dibuktikan web automation, pilih automation candidate yang bernilai, lalu rumuskan sebagai repeatable check."
      },
      "outcome": {
        "en": "Given a manual scenario, decide whether and where to automate it, then define its state, action, and observable evidence.",
        "id": "Dari skenario manual, tentukan apakah automation layak dan feedback layer mana yang tepat. Lalu rumuskan product risk, starting state, user action, serta observable evidence-nya."
      }
    },
    {
      "slug": "read-the-ui",
      "order": 2,
      "title": { "en": "Read the Web UI", "id": "Membaca Web UI" },
      "description": {
        "en": "Read semantic HTML, accessible identity, DOM context, and browser evidence before writing automation.",
        "id": "Pahami HTML semantik, accessible name, konteks DOM, dan evidence dari browser sebelum menulis web automation."
      },
      "outcome": {
        "en": "Inspect a live web UI, identify a control's meaning and context, and define the observable evidence an automation test should use.",
        "id": "Periksa Web UI yang aktif, kenali makna dan konteks sebuah kontrol, lalu tentukan observable evidence yang perlu dibuktikan automated test."
      }
    },
    {
      "slug": "first-test-code",
      "order": 3,
      "title": {
        "en": "First Test & Just-Enough Code",
        "id": "Test Pertama & Kode Secukupnya"
      },
      "description": {
        "en": "Run a real Playwright test and learn only the JavaScript and TypeScript needed to change it safely.",
        "id": "Jalankan test Playwright nyata dan pelajari JavaScript serta TypeScript yang diperlukan untuk mengubahnya dengan aman."
      },
      "outcome": {
        "en": "Run, read, and safely modify a small Playwright test.",
        "id": "Jalankan, baca, dan ubah test Playwright kecil dengan aman."
      }
    },
    {
      "slug": "reliable-locators",
      "order": 4,
      "title": {
        "en": "Reliable Locators & Testability",
        "id": "Locator Andal & Testability"
      },
      "description": {
        "en": "Choose locator contracts from test intent, narrow repeated UI, and use CSS or XPath only with a documented reason.",
        "id": "Pilih kontrak locator dari intent test, persempit repeated UI, dan gunakan CSS atau XPath hanya dengan alasan yang terdokumentasi."
      },
      "outcome": {
        "en": "Given a live UI and test intent, choose and justify a unique locator, narrow repeated content, and identify when an implementation fallback is warranted.",
        "id": "Dari live UI dan intent test, pilih dan jelaskan unique locator, persempit repeated content, lalu tentukan kapan implementation fallback memang diperlukan."
      }
    },
    {
      "slug": "actions-sync",
      "order": 5,
      "title": {
        "en": "Actions, Navigation & Synchronization",
        "id": "Aksi, Navigasi & Sinkronisasi"
      },
      "description": {
        "en": "Choose actions by user intent, separate action readiness from product outcomes, and follow results across browser surfaces.",
        "id": "Pilih action berdasarkan user intent, pisahkan kesiapan action dari product outcome, lalu ikuti hasilnya di berbagai browser surface."
      },
      "outcome": {
        "en": "Given a user flow, choose actions that express intended state, explain what Playwright waits for, and synchronize with observable same-page or new-surface outcomes without fixed sleeps.",
        "id": "Dari sebuah user flow, pilih action yang menjelaskan intended state, jelaskan apa yang ditunggu Playwright, lalu sinkronkan dengan observable outcome di page yang sama atau surface baru tanpa fixed sleep."
      }
    },
    {
      "slug": "assertions-test-design",
      "order": 6,
      "title": {
        "en": "Meaningful Assertions & Test Design",
        "id": "Assertion Bermakna & Desain Test"
      },
      "description": {
        "en": "Choose sufficient observable evidence and turn business rules into a focused, non-duplicative test portfolio.",
        "id": "Pilih observable evidence yang cukup lalu ubah business rule menjadi test portfolio yang fokus dan tidak duplikatif."
      },
      "outcome": {
        "en": "Given a product risk, design a focused scenario and use the smallest sufficient set of assertions to prove its business-relevant outcome.",
        "id": "Dari sebuah product risk, rancang skenario yang fokus lalu gunakan kumpulan assertion terkecil yang cukup untuk membuktikan business-relevant outcome."
      }
    },
    {
      "slug": "reliability-debugging",
      "order": 7,
      "title": {
        "en": "Reliability, Isolation & Debugging",
        "id": "Keandalan, Isolasi & Debugging"
      },
      "description": {
        "en": "Separate browser sessions, own mutable state, and diagnose failures through evidence instead of symptom-masking patches.",
        "id": "Pisahkan browser session, tentukan ownership untuk mutable state, lalu diagnosis failure lewat evidence tanpa symptom-masking patch."
      },
      "outcome": {
        "en": "Given an intermittent or state-dependent failure, control each test’s starting state, identify the cause from execution evidence, and verify a repair under the conditions that exposed it.",
        "id": "Saat menghadapi intermittent atau state-dependent failure, kontrol starting state setiap test, temukan penyebab dari execution evidence, lalu verifikasi repair pada kondisi yang mengeksposnya."
      }
    },
    {
      "slug": "maintainable-suites",
      "order": 8,
      "title": {
        "en": "Maintainable Suites",
        "id": "Test Suite yang Mudah Dirawat"
      },
      "description": {
        "en": "Choose the smallest useful abstraction, make test lifecycles explicit, and encode suite policy without hiding product intent.",
        "id": "Pilih abstraction terkecil yang berguna, buat test lifecycle explicit, lalu encode suite policy tanpa menyembunyikan product intent."
      },
      "outcome": {
        "en": "Given a growing suite, localize meaningful change with a justified abstraction, assign clear ownership and scope to test dependencies, and review configuration as executable policy.",
        "id": "Saat suite berkembang, lokalkan meaningful change lewat abstraction yang justified, tentukan ownership dan scope test dependency dengan jelas, lalu review configuration sebagai executable policy."
      }
    },
    {
      "slug": "ship-and-prove",
      "order": 9,
      "title": { "en": "Ship & Prove", "id": "Kirim & Buktikan" },
      "description": {
        "en": "Reproduce the test system in CI, select coverage from risk, preserve actionable evidence, and prove a focused capstone.",
        "id": "Reproduce test system di CI, pilih coverage dari risk, simpan actionable evidence, lalu buktikan lewat focused capstone."
      },
      "outcome": {
        "en": "Given a valuable product risk, deliver a reproducible feedback contract with intentional coverage, actionable evidence, owned failure handling, and a capstone claim whose limits you can explain.",
        "id": "Dari product risk yang bernilai, hasilkan reproducible feedback contract dengan intentional coverage, actionable evidence, ownership failure yang jelas, serta capstone claim yang batasnya bisa kamu jelaskan."
      }
    }
  ],

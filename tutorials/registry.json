{
  "modules": [
    {
      "slug": "automation-judgment",
      "order": 1,
      "title": {
        "en": "Automation Foundations & Judgment",
        "id": "Dasar & Pertimbangan Otomasi"
      },
      "description": {
        "en": "Understand what web automation can prove, choose worthwhile candidates, and frame them as repeatable checks.",
        "id": "Pahami hal yang dapat dibuktikan otomasi web, pilih kandidat yang bernilai, dan rumuskan sebagai pemeriksaan yang dapat diulang."
      },
      "outcome": {
        "en": "Given a manual scenario, decide whether and where to automate it, then define its state, action, and observable evidence.",
        "id": "Dari sebuah skenario manual, tentukan apakah dan di mana skenario perlu diotomasi, lalu definisikan kondisi, aksi, dan bukti yang dapat diamati."
      }
    },
    {
      "slug": "read-the-ui",
      "order": 2,
      "title": { "en": "Read the Web UI", "id": "Membaca UI Web" },
      "description": {
        "en": "Understand the browser-visible page, semantic HTML, accessible names, and changing DOM state.",
        "id": "Pahami halaman yang terlihat di browser, HTML semantik, accessible name, dan perubahan state DOM."
      },
      "outcome": {
        "en": "Explain what a user perceives and what an automation tool can reliably locate.",
        "id": "Jelaskan apa yang dipahami pengguna dan apa yang dapat ditemukan alat otomasi secara andal."
      }
    },
    {
      "slug": "first-test-code",
      "order": 3,
      "title": {
        "en": "First Test & Just-Enough Code",
        "id": "Test Pertama & Kode Secukupnya"
      },
      "description": {
        "en": "Run a real Playwright test and learn only the JavaScript and TypeScript needed to change it safely.",
        "id": "Jalankan test Playwright nyata dan pelajari JavaScript serta TypeScript yang diperlukan untuk mengubahnya dengan aman."
      },
      "outcome": {
        "en": "Run, read, and safely modify a small Playwright test.",
        "id": "Jalankan, baca, dan ubah test Playwright kecil dengan aman."
      }
    },
    {
      "slug": "reliable-locators",
      "order": 4,
      "title": {
        "en": "Reliable Locators & Testability",
        "id": "Locator Andal & Testability"
      },
      "description": {
        "en": "Choose locator contracts from test intent, narrow repeated UI, and use CSS or XPath only with a documented reason.",
        "id": "Pilih kontrak locator dari intent test, persempit repeated UI, dan gunakan CSS atau XPath hanya dengan alasan yang terdokumentasi."
      },
      "outcome": {
        "en": "Given a live UI and test intent, choose and justify a unique locator, narrow repeated content, and identify when an implementation fallback is warranted.",
        "id": "Dari live UI dan intent test, pilih dan jelaskan unique locator, persempit repeated content, lalu tentukan kapan implementation fallback memang diperlukan."
      }
    },
    {
      "slug": "actions-sync",
      "order": 5,
      "title": {
        "en": "Actions, Navigation & Synchronization",
        "id": "Aksi, Navigasi & Sinkronisasi"
      },
      "description": {
        "en": "Interact like a user while separating action readiness from the application outcome.",
        "id": "Berinteraksi seperti pengguna sambil membedakan kesiapan aksi dari hasil aplikasi."
      },
      "outcome": {
        "en": "Complete realistic interactions without fixed sleeps or accidental races.",
        "id": "Selesaikan interaksi realistis tanpa fixed sleep atau race yang tidak disengaja."
      }
    },
    {
      "slug": "assertions-test-design",
      "order": 6,
      "title": {
        "en": "Meaningful Assertions & Test Design",
        "id": "Assertion Bermakna & Desain Test"
      },
      "description": {
        "en": "Prove observable outcomes, cover useful risks, and avoid tests that pass without proving anything.",
        "id": "Buktikan hasil yang dapat diamati, cakup risiko yang berguna, dan hindari test yang lulus tanpa membuktikan apa pun."
      },
      "outcome": {
        "en": "Design a focused test whose assertions prove a business-relevant result.",
        "id": "Rancang test terfokus dengan assertion yang membuktikan hasil yang relevan bagi bisnis."
      }
    },
    {
      "slug": "reliability-debugging",
      "order": 7,
      "title": {
        "en": "Reliability, Isolation & Debugging",
        "id": "Keandalan, Isolasi & Debugging"
      },
      "description": {
        "en": "Control state and data, diagnose failures with evidence, and repair flaky or generated tests.",
        "id": "Kendalikan state dan data, diagnosis kegagalan dengan bukti, serta perbaiki test flaky atau buatan AI."
      },
      "outcome": {
        "en": "Diagnose and repair a failing test without hiding the failure behind waits or retries.",
        "id": "Diagnosis dan perbaiki test gagal tanpa menyembunyikan kegagalan dengan wait atau retry."
      }
    },
    {
      "slug": "maintainable-suites",
      "order": 8,
      "title": {
        "en": "Maintainable Suites",
        "id": "Test Suite yang Mudah Dirawat"
      },
      "description": {
        "en": "Use helpers, page or component objects, fixtures, configuration, and projects at the right time.",
        "id": "Gunakan helper, page atau component object, fixture, konfigurasi, dan project pada waktu yang tepat."
      },
      "outcome": {
        "en": "Organize a growing suite without premature or leaky abstractions.",
        "id": "Atur suite yang berkembang tanpa abstraksi prematur atau bocor."
      }
    },
    {
      "slug": "ship-and-prove",
      "order": 9,
      "title": { "en": "Ship & Prove", "id": "Kirim & Buktikan" },
      "description": {
        "en": "Run automation in CI, preserve useful evidence, cover browsers intentionally, and complete a practical capstone.",
        "id": "Jalankan otomasi di CI, simpan bukti yang berguna, cakup browser dengan sengaja, dan selesaikan capstone praktis."
      },
      "outcome": {
        "en": "Deliver a repeatable end-to-end suite and explain its reliability decisions.",
        "id": "Hasilkan suite end-to-end yang dapat diulang dan jelaskan keputusan keandalannya."
      }
    }
  ],

{
  "name": "twe",
  "private": true,
  "type": "module",
  "imports": {
    "#smtp-socket": {
      "workerd": "./src/server/smtp-socket.cloudflare.server.ts",
      "default": "./src/server/smtp-socket.unavailable.server.ts"
    },
    "#og-layout": {
      "workerd": "./src/server/og-layout.cloudflare.server.ts",
      "default": "./src/server/og-layout.bun.server.ts"
    },
    "#og-png": {
      "workerd": "./src/server/og-png.cloudflare.server.ts",
      "default": "./src/server/og-png.bun.server.ts"
    },
    "#platform": {
      "workerd": "./src/runtime/platform.cloudflare.ts",
      "browser": "./src/runtime/platform.browser.ts",
      "default": "./src/runtime/platform.local.ts"
    }
  },
  "scripts": {
    "setup": "bun scripts/local-cloudflare.ts setup",
    "dev:local": "bun scripts/local-cloudflare.ts dev",
    "db:up": "bun scripts/local-cloudflare.ts up",
    "db:stop": "bun scripts/local-cloudflare.ts stop",
    "dev": "vite dev --port 3000",
    "build": "bun scripts/build-cloudflare.ts",
    "preview": "vite preview --port 3000",
    "cf:dev": "bun run dev",
    "cf:build": "bun run build",
    "cf:preview": "bun run preview",
    "cf:deploy": "bun scripts/deploy-cloudflare.ts preview",
    "cf:typegen": "wrangler types src/worker-bindings.generated.d.ts",
    "cf:db:migrate": "bun run db:migrate",
    "cf:db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "test": "bun run test:unit",
    "test:unit": "bun test --preload ./src/tests/bun-preload.ts src/tests/unit",
    "test:integration": "bun scripts/test-d1.ts",
    "test:ci": "bun scripts/test-ci.ts",
    "test:e2e": "bun scripts/test-e2e.ts",
    "test:e2e:report": "allure generate allure-results --clean && allure open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:push": "bun run db:migrate",
    "db:studio": "wrangler d1 execute DB --local --command \"SELECT name FROM sqlite_schema WHERE type = 'table'\"",
    "content:generate": "bun scripts/generate-content-manifest.ts",
    "og:generate": "bun scripts/generate-og-assets.ts",
    "og:manifest": "bun scripts/generate-og-assets.ts --manifest-only",
    "db:sync": "bun run content:generate && bun src/scripts/sync-tutorials.ts && bun src/scripts/sync-challenges.ts && bun src/scripts/sync-achievements.ts",
    "db:reset-curriculum": "bun src/scripts/reset-curriculum-v2.ts",
    "db:docs": "bun src/scripts/generate-solutions-doc.ts",
    "start": "wrangler dev --ip 127.0.0.1 --port 3000",
    "cf:db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "cf:spike:dev": "bun --cwd spikes/cloudflare run dev",
    "cf:spike:build": "bun --cwd spikes/cloudflare run build",
    "db:pg:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "cf:build:preview": "bun scripts/build-cloudflare.ts preview",
    "cf:build:production": "bun scripts/build-cloudflare.ts production",
    "cf:deploy:production": "bun scripts/deploy-cloudflare.ts production",
    "migration:export": "bun scripts/migration/export-postgres.ts",
    "migration:import": "bun scripts/migration/import-d1.ts import",
    "migration:validate": "bun scripts/migration/import-d1.ts validate",
    "cf:backup": "bun scripts/backup-d1.ts",
    "cf:backup:keys": "bun scripts/backup-keys.ts",
    "cf:backup:prepare-restore": "bun scripts/prepare-d1-restore.ts",
    "cf:smoke": "bun scripts/smoke-cloudflare.ts",
    "migration:rehearse": "bun scripts/migration/rehearse-backup.ts",
    "migration:export:d1": "bun scripts/migration/export-d1.ts",
    "migration:restore:pg": "bun scripts/migration/restore-postgres.ts",
    "migration:freeze": "bun scripts/migration/freeze-d1.ts",
    "cf:preview:seed": "bun --no-env-file scripts/seed-preview.ts",
    "cf:smoke:preview": "bun --no-env-file scripts/smoke-preview.ts",
    "cf:audit:free": "bun --no-env-file scripts/audit-free-readiness.ts",
    "cf:measure:preview": "bun --no-env-file scripts/measure-preview.ts"
  },
  "dependencies": {
    "@cf-wasm/satori": "0.4.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-wasm": "2.6.2",
    "@sentry/react": "^10.35.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "better-auth": "^1.4.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "esbuild-wasm": "^0.27.2",
    "framer-motion": "^12.23.26",
    "highlight.js": "^11.11.1",
    "i18next": "^25.7.3",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.55.1",
    "openai": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.5.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "2.1.7",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@eslint/js": "^9.39.2",
    "@happy-dom/global-registrator": "^20.1.0",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "allure-playwright": "^3.4.4",
    "bun-types": "^1.3.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "happy-dom": "^20.0.11",
    "jsonc-parser": "3.3.1",
    "postgres": "^3.4.7",
    "prettier": "^3.7.4",
    "satori": "^0.19.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.1.7",
    "wrangler": "4.154.0"
  }
}
